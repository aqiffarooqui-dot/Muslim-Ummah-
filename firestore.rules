rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can create only a normal USER profile.
    // ADMIN profiles must be provisioned outside the client app.
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == "USER"
        && request.resource.data.isPremium == false;

      // Users can update their own profile, but cannot change role or premium entitlement.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.planType == resource.data.planType;

      allow read: if request.auth != null && request.auth.uid == userId;

      // Personal user data only.
      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default fallback: deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
