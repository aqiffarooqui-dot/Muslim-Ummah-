rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All nested user subcollections (quran, hadith, bookmarks, notes, khatam, prayer_tracker)
      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default fallback: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
